  "authentication": {
    "card_min_width": 480,
    "card_max_width": 560,
    "form_horizontal_padding": 24,
    "form_vertical_padding": 26
  },
  "native_exceptions": [
    "window_controls",
    "system_ui_font",
    "focus_visual",
    "file_picker",
    "accessibility_provider",
    "keyboard_modifier_names",
    "biometric_provider",
    "protected_storage_provider"
