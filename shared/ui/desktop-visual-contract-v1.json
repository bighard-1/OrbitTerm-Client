{
  "schema_version": 1,
  "genre": "compact-professional-operations-workstation",
  "window": {
    "comfortable_minimum_width": 980,
    "comfortable_minimum_height": 700,
    "compact_minimum_width": 820,
    "linux_compact_minimum_width": 760,
    "compact_minimum_height": 560,
    "windows_command_lane_minimum_width": 980,
    "preferred_width": 1280,
    "preferred_height": 800,
    "initial_work_area_ratio": 0.88,
    "compact_initial_work_area_ratio": 0.75,
    "collapse_side_panes_first": true,
    "automatic_terminal_font_scaling": false
  },
  "chrome": {
    "command_lane_height": 36,
    "command_button_width": 82,
    "compact_command_button_width": 62,
    "command_button_height": 28,
    "command_button_single_line": true,
    "workspace_product_logo_visible": false,
    "system_shell_app_icon_required": true,
    "account_button_content": "avatar_and_label",
    "overview_lane_min_height": 34,
    "overview_lane_max_height": 40,
    "logo_size": 22,
    "logo_corner_radius": 7,
    "command_gap": 5,
    "command_horizontal_padding": 10,
    "command_vertical_padding": 5
  },
  "panes": {
    "asset": {
      "preferred_width": 300,
      "minimum_width": 220,
      "maximum_width": 320,
      "preferred_window_ratio": 0.234375,
      "collapse_below_window_width": 980
    },
    "terminal": {
      "minimum_width": 560,
      "compact_minimum_width": 500
    },
    "tools": {
      "preferred_width": 328,
      "minimum_width": 280,
      "maximum_width": 420,
      "preferred_window_ratio": 0.25625,
      "collapse_below_window_width": 1180
    },
    "collapsed_layout_width": 0,
    "edge_restore_hit_width": 10,
    "edge_restore_indicator_width": 2,
    "edge_restore_indicator_height": 40,
    "edge_restore_reveal": "hover_or_keyboard_focus",
    "splitter_hit_width": 10,
    "splitter_visual_width": 1
  },
  "overview": {
    "endpoint_order": 0,
    "metric_order": ["cpu", "memory", "disk", "download", "upload", "tcp_latency"],
    "detail_width": 54,
    "gap": 6,
    "card_corner_radius": 10,
    "sparkline_height": 10,
    "network_rate_base_unit": "kilobits_per_second",
    "network_rate_display_units": ["Kbps", "Mbps", "Gbps"]
  },
  "status_footer": {
    "show_remote_revision": false,
    "synchronization_action": "run_now",
    "reason": "remote revisions belong in synchronization diagnostics and conflict resolution, not the persistent health summary"
  },
  "spacing": [4, 8, 12, 16, 24],
  "radii": {
    "control": 6,
    "workstation_card": 10,
    "dialog": 14,
    "authentication_card": 20
  },
  "authentication": {
    "card_min_width": 480,
    "card_max_width": 560,
    "form_horizontal_padding": 24,
    "form_vertical_padding": 26,
    "separate_states": ["sign_in_or_register", "master_password", "sync_management"],
    "persistent_product_logo": false,
    "security_gate_icon": "native_lock_shield"
  },
  "host_key_rotation": {
    "changed_key_is_blocking": true,
    "recovery": "remove_exact_previous_fingerprint_then_reconnect_as_unknown",
    "automatic_replacement_trust": false
  },
  "snippets": {
    "card_fields": ["title", "command", "category", "asset_scope"],
    "primary_actions": ["insert", "execute"],
    "header_actions": ["search", "save_from_history", "create"],
    "secondary_actions": ["edit", "delete"],
    "scope_labels": {
      "all": "全部资产",
      "restricted_pattern": "限 {count} 台资产"
    }
  },
  "sftp": {
    "navigation_actions": ["parent", "path", "refresh", "overflow"],
    "editor_actions": ["revert", "copy", "save", "cancel"],
    "transfer_queue_initially_expanded": false,
    "scrolling_requires_visible_scrollbar": false,
    "error_message_must_wrap": true,
    "raw_bridge_error_visible": false,
    "single_click_behavior": "selection_only",
    "batch_actions_minimum_selection_count": 2
  },
  "session_tools": {
    "startup_without_session": "collapsed",
    "verified_ssh_connection": "auto_expand_unless_user_overridden",
    "manual_visibility_wins": true
  },
  "native_exceptions": [
    "window_controls",
    "system_ui_font",
    "focus_visual",
    "file_picker",
    "accessibility_provider",
    "keyboard_modifier_names",
    "biometric_provider",
    "protected_storage_provider"
  ]
}
