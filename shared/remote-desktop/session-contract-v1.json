{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract": "orbitterm.remote-desktop.session",
  "version": 1,
  "engine": "freerdp",
  "controllerPlatforms": ["windows", "macos", "ios", "android", "linux"],
  "supportedTargetPlatforms": ["windows", "linux"],
  "unsupportedTargetPlatforms": ["macos"],
  "phases": [
    "starting",
    "authenticating",
    "awaitingUserDecision",
    "connected",
    "reconnecting",
    "disconnected",
    "failed",
    "closed"
  ],
  "allowedTransitions": {
    "starting": ["authenticating", "awaitingUserDecision", "failed", "closed"],
    "authenticating": ["awaitingUserDecision", "connected", "reconnecting", "failed", "closed"],
    "awaitingUserDecision": ["authenticating", "connected", "reconnecting", "failed", "closed"],
    "connected": ["reconnecting", "disconnected", "failed", "closed"],
    "reconnecting": ["authenticating", "awaitingUserDecision", "connected", "disconnected", "failed", "closed"],
    "disconnected": ["reconnecting", "closed"],
    "failed": ["reconnecting", "closed"],
    "closed": []
  },
  "failureKinds": [
    "engineUnavailable",
    "invalidTarget",
    "certificateRejected",
    "authenticationFailed",
    "networkUnavailable",
    "timedOut",
    "protocolError",
    "cancelled",
    "unknown"
  ],
  "failurePresentation": {
    "mustBeModalOrNativeAlert": true,
    "mustDistinguish": [
      "authenticationFailed",
      "networkOrServiceUnavailable",
      "nameResolutionFailed",
      "certificateRejected",
      "timedOut",
      "protocolError"
    ],
    "credentialDataForbidden": true,
    "retryActionRequired": true
  },
  "displayPolicy": {
    "userSelectableRuntimeResolution": false,
    "safeInitialDesktop": { "width": 1280, "height": 720 },
    "localSmartScalingRequired": true,
    "unsupportedRemoteModeMustNotDisconnect": true,
    "fullscreenControlsAutoHide": true,
    "fullscreenControlsRevealAtTopEdge": true
  },
  "inputRouting": {
    "localSystemShortcutsWinUnlessExplicitlyCaptured": true,
    "applicationShortcutsRequireApplicationFocus": true,
    "remoteSurfaceFocusRoutesOrdinaryKeysToRemote": true,
    "remoteSystemShortcutCaptureMustBeExplicit": true,
    "captureReleaseGestures": ["Ctrl+Alt+Shift+Escape", "Platform+Escape"],
    "modifierStateMustBeReleasedOnFocusLoss": true,
    "localImeCommitUsesBoundedUnicodeInput": true,
    "controlAltAndPlatformShortcutsBypassLocalIme": true
  },
  "security": {
    "requireNlaByDefault": true,
    "certificateDecisionMustBeExplicit": true,
    "credentialPayloadForbiddenInProfile": true,
    "fallbackToSshForbidden": true,
    "macosTargetForbidden": true,
    "clipboardRedirectionDefault": false,
    "clipboardRedirectionCurrentlyEnabled": false,
    "composedTextMustNotBeLoggedOrPersisted": true
  }
}
