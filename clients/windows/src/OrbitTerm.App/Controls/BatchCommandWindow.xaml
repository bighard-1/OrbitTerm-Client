<!-- Hallmark · genre: modern-minimal · macrostructure: Workbench · theme: existing OrbitTerm tokens · designed-as-app -->
<!-- Hallmark · pre-emit critique: P5 H5 E5 S5 R5 V5 -->
<Window
    x:Class="OrbitTerm.App.Controls.BatchCommandWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="WindowRoot"
          Background="{StaticResource OrbitFeatureWindowBrush}"
          RowDefinitions="38,*">
        <Border x:Name="AppTitleBar"
                Grid.Row="0"
                Background="{StaticResource OrbitFeatureTitleBarBrush}"
                BorderBrush="{StaticResource OrbitFeatureWindowStrokeBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,0,156,0">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Border Width="22" Height="22" CornerRadius="7" Background="{StaticResource OrbitPanelBrush}">
                    <Image Source="ms-appx:///Assets/Square44x44Logo.png"
                           Stretch="Uniform"
                           AutomationProperties.Name="OrbitTerm 标志" />
                </Border>
                <TextBlock Text="批量命令" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="独立执行工作区"
                           FontSize="12"
                           Foreground="{StaticResource OrbitMutedTextBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1"
              Background="{StaticResource OrbitFeatureWindowBrush}"
              Padding="12"
              RowSpacing="10"
              RowDefinitions="Auto,*,Auto">
            <Border Grid.Row="0"
                    Padding="12,8"
                    CornerRadius="{StaticResource OrbitCardCornerRadius}"
                    Background="{StaticResource OrbitFeatureInnerBrush}"
                    BorderBrush="{StaticResource OrbitFeatureWindowStrokeBrush}"
                    BorderThickness="1">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="3">
                        <TextBox x:Name="CommandTextBox"
                                 PlaceholderText="输入要执行的命令"
                                 Text="{Binding BatchCommandText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="8192"
                                 FontFamily="Consolas"
                                 AutomationProperties.Name="批量命令内容" />
                        <TextBlock Grid.Row="1"
                                   Text="{Binding BatchCommandGuidance}"
                                   FontSize="11"
                                   Foreground="{StaticResource OrbitMutedTextBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   AutomationProperties.LiveSetting="Polite" />
                    </Grid>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <ToggleSwitch OffContent="一次性" OnContent="持续任务"
                                      IsOn="{Binding IsBatchContinuousMode, Mode=TwoWay}"
                                      AutomationProperties.Name="切换批量命令执行模式" />
                        <ComboBox Width="92"
                                  ItemsSource="{Binding BatchContinuousTimeoutOptions}"
                                  SelectedItem="{Binding BatchContinuousTimeoutMinutes, Mode=TwoWay}"
                                  AutomationProperties.Name="持续任务自动停止分钟数" />
                        <TextBlock Text="分钟" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" ColumnSpacing="10" ColumnDefinitions="Auto,*">
                <Border x:Name="TargetPanel"
                        Grid.Column="0"
                        Width="536"
                        Padding="10"
                        CornerRadius="{StaticResource OrbitCardCornerRadius}"
                        Background="{StaticResource OrbitFeatureInnerBrush}"
                        BorderBrush="{StaticResource OrbitFeatureWindowStrokeBrush}"
                        BorderThickness="1">
                    <Grid RowDefinitions="Auto,*" RowSpacing="5">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                            <StackPanel>
                                <TextBlock Text="执行目标" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="分组仅筛选，不会自动勾选"
                                           FontSize="11"
                                           Foreground="{StaticResource OrbitMutedTextBrush}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Width="30" Height="30" Padding="0"
                                    Click="CollapseTargetPanelClick"
                                    ToolTipService.ToolTip="收起目标选择区"
                                    AutomationProperties.Name="收起目标选择区">
                                <FontIcon Glyph="&#xE76B;" FontSize="12" />
                            </Button>
                        </Grid>

                        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Pivot Grid.Column="0">
                            <PivotItem Header="资产库">
                                <Grid Margin="0,6,0,0"
                                      RowDefinitions="Auto,Auto,Auto,Auto,*"
                                      RowSpacing="7">
                                    <ComboBox ItemsSource="{Binding BatchTargetGroups}"
                                              SelectedItem="{Binding SelectedBatchTargetGroup, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch"
                                              AutomationProperties.Name="筛选资产分组" />
                                    <TextBox Grid.Row="1"
                                             PlaceholderText="搜索名称、地址或状态"
                                             Text="{Binding BatchTargetQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="搜索批量命令资产" />
                                    <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="7">
                                        <Button Content="全选当前结果"
                                                Click="SelectFilteredTargetsClick"
                                                HorizontalAlignment="Stretch"
                                                AutomationProperties.Name="选择当前筛选结果中的全部资产" />
                                        <Button Grid.Column="1"
                                                Content="清空已选"
                                                Click="ClearSelectionClick"
                                                HorizontalAlignment="Stretch"
                                                AutomationProperties.Name="清除全部批量执行目标" />
                                    </Grid>
                                    <TextBlock Grid.Row="3"
                                               Text="{Binding BatchTargetFilterSummary}"
                                               FontSize="11"
                                               Foreground="{StaticResource OrbitMutedTextBrush}"
                                               TextWrapping="Wrap" />
                                    <ListView Grid.Row="4"
                                              ItemsSource="{Binding FilteredBatchAssetTargets}"
                                              SelectionMode="None"
                                              AutomationProperties.Name="当前分组中的 SSH 资产">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="Margin" Value="0,0,0,5" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="7,5"
                                                        CornerRadius="{StaticResource OrbitCornerRadius}"
                                                        Background="{StaticResource OrbitMetricBrush}"
                                                        BorderBrush="{StaticResource OrbitPanelStrokeBrush}"
                                                        BorderThickness="1">
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                  Click="BatchTargetSelectionChanged"
                                                                  VerticalAlignment="Center"
                                                                  AutomationProperties.Name="选择此 SSH 资产用于批量命令" />
                                                        <StackPanel Grid.Column="1" Spacing="1">
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Endpoint}"
                                                                       FontSize="11"
                                                                       Foreground="{StaticResource OrbitMutedTextBrush}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <TextBlock Text="{Binding Group}"
                                                                           FontSize="10"
                                                                           Foreground="{StaticResource OrbitMutedTextBrush}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding StateText}"
                                                                           FontSize="10"
                                                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </Grid>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Grid>
                            </PivotItem>
                            </Pivot>
                            <Pivot Grid.Column="1">
                            <PivotItem Header="已选资产">
                                <Grid Margin="0,6,0,0" RowDefinitions="Auto,*" RowSpacing="7">
                                    <Border Padding="8,6"
                                            CornerRadius="{StaticResource OrbitCornerRadius}"
                                            Background="{StaticResource OrbitMetricBrush}"
                                            BorderBrush="{StaticResource OrbitPanelStrokeBrush}"
                                            BorderThickness="1">
                                        <TextBlock Text="{Binding BatchTargetSummary}" FontSize="11" TextWrapping="Wrap" />
                                    </Border>
                                    <ListView Grid.Row="1"
                                              ItemsSource="{Binding SelectedBatchAssetTargets}"
                                              SelectionMode="None"
                                              AutomationProperties.Name="已选择的批量命令资产">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="Margin" Value="0,0,0,5" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="7,5"
                                                        CornerRadius="{StaticResource OrbitCornerRadius}"
                                                        Background="{StaticResource OrbitMetricBrush}"
                                                        BorderBrush="{StaticResource OrbitPanelStrokeBrush}"
                                                        BorderThickness="1">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                        <StackPanel Spacing="1">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Endpoint}"
                                                                       FontSize="11"
                                                                       Foreground="{StaticResource OrbitMutedTextBrush}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1"
                                                                Width="28" Height="28" Padding="0"
                                                                Click="RemoveSelectedTargetClick"
                                                                ToolTipService.ToolTip="从批量目标中移除"
                                                                AutomationProperties.Name="从批量目标中移除此资产">
                                                            <FontIcon Glyph="&#xE711;" FontSize="10" />
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Grid>
                            </PivotItem>
                            </Pivot>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="1"
                        Padding="10"
                        CornerRadius="{StaticResource OrbitCardCornerRadius}"
                        Background="{StaticResource OrbitFeatureInnerBrush}"
                        BorderBrush="{StaticResource OrbitFeatureWindowStrokeBrush}"
                        BorderThickness="1">
                    <Grid RowDefinitions="Auto,*" RowSpacing="4">
                        <Button x:Name="ExpandTargetPanelButton"
                                Visibility="Collapsed"
                                HorizontalAlignment="Left"
                                Content="显示执行目标"
                                Click="ExpandTargetPanelClick"
                                AutomationProperties.Name="显示执行目标选择区" />
                        <Pivot Grid.Row="1" SelectedIndex="{Binding BatchResultViewIndex, Mode=TwoWay}">
                            <PivotItem Header="一次性回执">
                                <Grid Margin="0,5,0,0" RowDefinitions="Auto,*" RowSpacing="6">
                                    <Grid RowDefinitions="Auto,Auto" RowSpacing="6">
                                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="7">
                                            <TextBox PlaceholderText="搜索资产、地址、状态或输出"
                                                     Text="{Binding BatchResultQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="搜索批量命令结果" />
                                            <ToggleButton Grid.Column="1"
                                                          Content="仅看失败"
                                                          IsChecked="{Binding ShowOnlyFailedBatchResults, Mode=TwoWay}"
                                                          AutomationProperties.Name="仅显示失败的批量命令结果" />
                                            <Button x:Name="ExportTextButton"
                                                    Grid.Column="2"
                                                    Content="导出 TXT"
                                                    Click="ExportTextResultsClick"
                                                    AutomationProperties.Name="导出筛选后的批量命令文本结果" />
                                            <Button x:Name="ExportCsvButton"
                                                    Grid.Column="3"
                                                    Content="导出 CSV"
                                                    Click="ExportCsvResultsClick"
                                                    AutomationProperties.Name="导出筛选后的批量命令表格结果" />
                                        </Grid>
                                        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                                        <ProgressRing Width="16" Height="16"
                                                      IsActive="{Binding RunBatchCommand.IsRunning}"
                                                      VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="1">
                                            <TextBlock Text="{Binding BatchStatus}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       AutomationProperties.LiveSetting="Polite" />
                                            <TextBlock Text="{Binding BatchCurrentTarget}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource OrbitMutedTextBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <ProgressBar Minimum="0"
                                                             Maximum="{Binding BatchProgressMaximum}"
                                                             Value="{Binding BatchProgressValue}"
                                                             Height="3"
                                                             VerticalAlignment="Center"
                                                             AutomationProperties.Name="批量命令逐资产执行进度" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding BatchProgressText}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource OrbitMutedTextBrush}" />
                                            </Grid>
                                        </StackPanel>
                                        <Button x:Name="CopyResultsButton"
                                                Grid.Column="2"
                                                Content="复制结果"
                                                MinWidth="82"
                                                Click="CopyResultsClick"
                                                AutomationProperties.Name="复制当前筛选的批量命令结果" />
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding BatchResultFilterSummary}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource OrbitMutedTextBrush}"
                                                   VerticalAlignment="Center" />
                                        </Grid>
                                    </Grid>
                                    <TextBox Grid.Row="1"
                                             Text="{Binding FilteredBatchOutputText, Mode=OneWay}"
                                             PlaceholderText="执行后将在此显示完整的逐资产回执"
                                             IsReadOnly="True"
                                             AcceptsReturn="True"
                                             TextWrapping="NoWrap"
                                             FontFamily="Consolas"
                                             FontSize="12"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Stretch"
                                             HorizontalContentAlignment="Stretch"
                                             VerticalContentAlignment="Top"
                                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             AutomationProperties.Name="批量命令完整执行结果" />
                                </Grid>
                            </PivotItem>

                            <PivotItem Header="持续任务">
                                <Grid Margin="0,5,0,0" RowDefinitions="Auto,*" RowSpacing="6">
                                    <Grid ColumnDefinitions="Auto,280,*,Auto,Auto" ColumnSpacing="8">
                                        <TextBlock Text="任务" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding BatchContinuousSessions}"
                                                  SelectedItem="{Binding SelectedBatchContinuousSession, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch"
                                                  AutomationProperties.Name="选择持续任务">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Status}"
                                                                   Foreground="{StaticResource OrbitMutedTextBrush}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <StackPanel Grid.Column="2" Spacing="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding BatchContinuousSummary}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource OrbitMutedTextBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       AutomationProperties.LiveSetting="Polite" />
                                            <TextBlock Text="{Binding SelectedBatchContinuousSession.Endpoint}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource OrbitMutedTextBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Grid.Column="3"
                                                Content="停止当前"
                                                MinWidth="88"
                                                Click="StopSelectedContinuousSessionClick"
                                                AutomationProperties.Name="停止当前资产的持续任务" />
                                        <Button x:Name="CopyContinuousOutputButton"
                                                Grid.Column="4"
                                                Content="复制输出"
                                                MinWidth="88"
                                                Click="CopyContinuousOutputClick"
                                                AutomationProperties.Name="复制当前持续任务输出" />
                                    </Grid>
                                    <TextBox Grid.Row="1"
                                             Text="{Binding SelectedBatchContinuousSession.OutputText, Mode=OneWay}"
                                             PlaceholderText="启动持续任务后，在上方选择资产查看实时输出"
                                             IsReadOnly="True"
                                             AcceptsReturn="True"
                                             TextWrapping="NoWrap"
                                             FontFamily="Consolas"
                                             FontSize="12"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Stretch"
                                             HorizontalContentAlignment="Stretch"
                                             VerticalContentAlignment="Top"
                                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             AutomationProperties.Name="当前持续任务实时输出" />
                                </Grid>
                            </PivotItem>
                        </Pivot>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                <TextBlock Text="目标区可收起；结果与持续输出不会因资产数量增加而缩小。"
                           FontSize="11"
                           Foreground="{StaticResource OrbitMutedTextBrush}"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Command="{Binding CancelBatchCommand}"
                        Content="取消执行"
                        MinWidth="96"
                        AutomationProperties.Name="取消正在执行的批量命令" />
                <Button Grid.Column="2"
                        Command="{Binding RunBatchCommand}"
                        MinWidth="124"
                        AutomationProperties.Name="开始执行批量命令">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xE768;" FontSize="14" />
                        <TextBlock Text="开始执行" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="3" Content="关闭" MinWidth="80" Click="CloseClick" />
            </Grid>
        </Grid>

        <!-- Palette-aware perimeter frame: strong enough to separate this
             owned workspace from its owner without becoming an accent box. -->
        <Border Grid.RowSpan="2"
                Margin="1"
                BorderBrush="{StaticResource OrbitFeatureWindowStrokeBrush}"
                BorderThickness="2,0,2,2"
                CornerRadius="12"
                IsHitTestVisible="False"
                AutomationProperties.AccessibilityView="Raw" />
    </Grid>
</Window>
