<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <!-- Checkbox and ListView multi-select indicators use deliberately
             contrasting theme colours.  The glyph plus a selected-row tint
             provides two independent selection cues. -->
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="#FF005FB8" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="#FF004F9A" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="#FF003E7A" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#FF005FB8" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#FF004F9A" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#FF003E7A" />
            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeIndeterminate" Color="#FF005FB8" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillIndeterminate" Color="#FF005FB8" />
            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundIndeterminate" Color="#FFFFFFFF" />

            <!-- Windows 10's ListViewItemPresenter renders the selected state
                 as a standalone glyph on top of the selected row, rather than
                 always painting the CheckBoxSelectedBrush square.  Keep the
                 glyph dark in light mode so both presenter variants remain
                 clearly visible. -->
            <SolidColorBrush x:Key="ListViewItemCheckBrush" Color="#FF004A8F" />
            <SolidColorBrush x:Key="ListViewItemCheckPressedBrush" Color="#FF00366A" />
            <SolidColorBrush x:Key="ListViewItemCheckDisabledBrush" Color="#FF6685A3" />
            <SolidColorBrush x:Key="ListViewItemCheckBoxBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ListViewItemCheckBoxPointerOverBrush" Color="#FFF4F8FC" />
            <SolidColorBrush x:Key="ListViewItemCheckBoxPressedBrush" Color="#FFE7EEF6" />
            <SolidColorBrush x:Key="ListViewItemCheckBoxSelectedBrush" Color="#FFB7D7F4" />
            <SolidColorBrush x:Key="ListViewItemCheckBoxSelectedPointerOverBrush" Color="#FFA5CCEF" />
            <SolidColorBrush x:Key="ListViewItemCheckBoxSelectedPressedBrush" Color="#FF8DBBE5" />
            <SolidColorBrush x:Key="ListViewItemCheckBoxSelectedDisabledBrush" Color="#FFD5E3F0" />
            <SolidColorBrush x:Key="ListViewItemCheckBoxBorderBrush" Color="#FF536273" />
            <SolidColorBrush x:Key="ListViewItemCheckBoxPointerOverBorderBrush" Color="#FF005FB8" />
            <SolidColorBrush x:Key="ListViewItemCheckBoxPressedBorderBrush" Color="#FF003E7A" />
            <SolidColorBrush x:Key="ListViewItemCheckBoxDisabledBorderBrush" Color="#FF9AA5B1" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#FFDCEBFA" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#FFCEE3F7" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#FFBCD8F1" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="#FF0078D4" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="#FF168DE2" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="#FF005A9E" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#FF0078D4" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#FF168DE2" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#FF005A9E" />
            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeIndeterminate" Color="#FF0078D4" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillIndeterminate" Color="#FF0078D4" />
            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundIndeterminate" Color="#FFFFFFFF" />

            <SolidColorBrush x:Key="ListViewItemCheckBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ListViewItemCheckPressedBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ListViewItemCheckDisabledBrush" Color="#BFFFFFFF" />
            <SolidColorBrush x:Key="ListViewItemCheckBoxBrush" Color="#FF263444" />
            <SolidColorBrush x:Key="ListViewItemCheckBoxPointerOverBrush" Color="#FF34485D" />
            <SolidColorBrush x:Key="ListViewItemCheckBoxPressedBrush" Color="#FF1E2A38" />
            <SolidColorBrush x:Key="ListViewItemCheckBoxSelectedBrush" Color="#FF0078D4" />
            <SolidColorBrush x:Key="ListViewItemCheckBoxSelectedPointerOverBrush" Color="#FF168DE2" />
            <SolidColorBrush x:Key="ListViewItemCheckBoxSelectedPressedBrush" Color="#FF005A9E" />
            <SolidColorBrush x:Key="ListViewItemCheckBoxSelectedDisabledBrush" Color="#FF426F96" />
            <SolidColorBrush x:Key="ListViewItemCheckBoxBorderBrush" Color="#FFD7E3F4" />
            <SolidColorBrush x:Key="ListViewItemCheckBoxPointerOverBorderBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ListViewItemCheckBoxPressedBorderBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ListViewItemCheckBoxDisabledBorderBrush" Color="#FF7C8796" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#FF173B5C" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#FF1D486E" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#FF12314D" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <StaticResource x:Key="CheckBoxCheckBackgroundStrokeChecked" ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource x:Key="CheckBoxCheckBackgroundFillChecked" ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource x:Key="CheckBoxCheckGlyphForegroundChecked" ResourceKey="SystemColorHighlightTextColorBrush" />
            <StaticResource x:Key="ListViewItemCheckBrush" ResourceKey="SystemColorHighlightTextColorBrush" />
            <StaticResource x:Key="ListViewItemCheckBoxSelectedBrush" ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource x:Key="ListViewItemCheckBoxBorderBrush" ResourceKey="SystemColorWindowTextColorBrush" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
    <x:Double x:Key="OrbitSpace2">8</x:Double>
    <x:Double x:Key="OrbitSpace3">12</x:Double>
    <x:Double x:Key="OrbitSpace4">16</x:Double>
    <x:Double x:Key="OrbitSidebarMinWidth">220</x:Double>
    <x:Double x:Key="OrbitInspectorMinWidth">280</x:Double>
    <x:Double x:Key="OrbitTerminalMinWidth">560</x:Double>
    <!-- Hallmark · macrostructure: Layered Workbench · tone: calm operational desktop · anchor hue: user-selected five-palette system -->
    <!-- Hallmark · pre-emit critique: P5 H5 E5 S5 R5 V4 -->
    <!-- Windows keeps Fluent controls, while these semantic tokens mirror the macOS workstation hierarchy. -->
    <CornerRadius x:Key="OrbitCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="OrbitCardCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="OrbitDialogCornerRadius">14</CornerRadius>
    <!-- WinUI's ContentDialog, flyout and picker presenters consume this
         theme resource inside their default templates. -->
    <CornerRadius x:Key="OverlayCornerRadius">14</CornerRadius>
    <FontFamily x:Key="OrbitUiFont">Segoe UI Variable</FontFamily>
    <FontFamily x:Key="OrbitTerminalFont">Cascadia Mono</FontFamily>
    <SolidColorBrush x:Key="OrbitTerminalBackgroundBrush" Color="#101318" />
    <SolidColorBrush x:Key="OrbitTerminalBorderBrush" Color="#2B313A" />
    <SolidColorBrush x:Key="OrbitTerminalTextBrush" Color="#D7DEE8" />
    <SolidColorBrush x:Key="OrbitWorkbenchBrush" Color="#F3F7FF" />
    <SolidColorBrush x:Key="OrbitChromeBrush" Color="#EAF2FF" />
    <SolidColorBrush x:Key="OrbitPanelBrush" Color="#F8FBFF" />
    <SolidColorBrush x:Key="OrbitPanelStrokeBrush" Color="#D6E1F0" />
    <SolidColorBrush x:Key="OrbitMetricBrush" Color="#F1F6FF" />
    <SolidColorBrush x:Key="OrbitAccentBrush" Color="#146CC5" />
    <SolidColorBrush x:Key="OrbitPrimaryTextBrush" Color="#172033" />
    <SolidColorBrush x:Key="OrbitMutedTextBrush" Color="#5B6675" />
    <SolidColorBrush x:Key="OrbitDialogSurfaceBrush" Color="#F8FBFF" />
    <!-- Independent workspaces intentionally sit one elevation step above the
         main workstation.  Keeping these semantic brushes separate prevents
         feature windows from visually dissolving into the owner window. -->
    <SolidColorBrush x:Key="OrbitFeatureWindowBrush" Color="#FBFDFF" />
    <SolidColorBrush x:Key="OrbitFeatureTitleBarBrush" Color="#E2ECF8" />
    <SolidColorBrush x:Key="OrbitFeatureWindowStrokeBrush" Color="#9AB5D2" />
    <SolidColorBrush x:Key="OrbitFeatureInnerBrush" Color="#F4F8FD" />
    <SolidColorBrush x:Key="OrbitAccentSoftBrush" Color="#E2EEFC" />
    <SolidColorBrush x:Key="OrbitSuccessBrush" Color="#16784A" />
    <SolidColorBrush x:Key="OrbitWarningBrush" Color="#8A5A00" />
    <SolidColorBrush x:Key="OrbitDangerBrush" Color="#B42318" />
    <SolidColorBrush x:Key="OrbitDangerSoftBrush" Color="#FDEBE9" />
    <!-- Respect Windows high-contrast and keyboard focus conventions. -->
    <Style x:Key="OrbitButtonBaseStyle"
           TargetType="Button"
           BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style TargetType="Button"
           BasedOn="{StaticResource OrbitButtonBaseStyle}" />
    <Style x:Key="OrbitTitleBarButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource OrbitButtonBaseStyle}">
        <Setter Property="Width" Value="96" />
        <Setter Property="MinWidth" Value="96" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="8,3" />
    </Style>
    <Style x:Key="OrbitModuleButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource OrbitButtonBaseStyle}">
        <Setter Property="Width" Value="112" />
        <Setter Property="MinWidth" Value="112" />
    </Style>
    <Style x:Key="OrbitWideActionButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource OrbitButtonBaseStyle}">
        <Setter Property="Width" Value="136" />
        <Setter Property="MinWidth" Value="136" />
    </Style>
    <Style x:Key="OrbitIconButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource OrbitButtonBaseStyle}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style x:Key="OrbitSftpToolbarButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource OrbitButtonBaseStyle}">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="6,5" />
    </Style>
    <Style x:Key="OrbitSftpInlineButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource OrbitButtonBaseStyle}">
        <Setter Property="Width" Value="68" />
        <Setter Property="MinWidth" Value="68" />
        <Setter Property="Padding" Value="8,5" />
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="MinHeight" Value="32" />
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="MinHeight" Value="32" />
    </Style>
    <Style TargetType="ListViewItem">
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>
    <Style TargetType="CheckBox"
           BasedOn="{StaticResource DefaultCheckBoxStyle}">
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>
    <Style TargetType="Expander">
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>
    <Style TargetType="ContentDialog"
           BasedOn="{StaticResource DefaultContentDialogStyle}">
        <Setter Property="CornerRadius" Value="{StaticResource OrbitDialogCornerRadius}" />
        <Setter Property="Background" Value="{StaticResource OrbitDialogSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource OrbitFeatureWindowStrokeBrush}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
</ResourceDictionary>
