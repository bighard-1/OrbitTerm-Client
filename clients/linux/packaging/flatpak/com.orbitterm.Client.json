{
  "app-id": "com.orbitterm.Client",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "command": "orbitterm-linux",
  "finish-args": [
    "--share=network",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=dri",
    "--talk-name=org.freedesktop.secrets"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "env": {
      "CARGO_HOME": "/run/build/orbitterm/cargo"
    }
  },
  "modules": [
    {
      "name": "freerdp-core",
      "buildsystem": "cmake-ninja",
      "builddir": true,
      "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DCMAKE_INSTALL_LIBDIR=lib",
        "-DBUILD_SHARED_LIBS=ON",
        "-DBUILD_TESTING=OFF",
        "-DWITH_CLIENT_COMMON=ON",
        "-DWITH_CLIENT=OFF",
        "-DWITH_CHANNELS=ON",
        "-DWITH_CLIENT_CHANNELS=ON",
        "-DCHANNEL_DRDYNVC_CLIENT=ON",
        "-DCHANNEL_DISP_CLIENT=OFF",
        "-DCHANNEL_RDPGFX_CLIENT=ON",
        "-DWITH_SERVER=OFF",
        "-DWITH_SHADOW=OFF",
        "-DWITH_PROXY=OFF",
        "-DWITH_SAMPLE=OFF",
        "-DWITH_MANPAGES=OFF",
        "-DWITH_X11=OFF",
        "-DWITH_WAYLAND=OFF",
        "-DWITH_SDL=OFF",
        "-DWITH_FFMPEG=OFF",
        "-DWITH_OPENH264=OFF",
        "-DWITH_CUPS=OFF",
        "-DWITH_PCSC=OFF",
        "-DWITH_PULSE=OFF",
        "-DWITH_ALSA=OFF",
        "-DWITH_FUSE=OFF",
        "-DWITH_KRB5=OFF"
      ],
      "post-install": [
        "install -Dm644 ../LICENSE /app/share/licenses/com.orbitterm.Client/FreeRDP.LICENSE"
      ],
      "sources": [
        {
          "type": "archive",
          "path": "sources/freerdp-3.30.0.tar.gz",
          "sha256": "e2687d02dea6fede004d36391dac1a74ce57a210f8867fd95033171d4909590c"
        }
      ]
    },
    {
      "name": "vte",
      "buildsystem": "meson",
      "config-opts": [
        "--libdir=lib",
        "-Dapp=false",
        "-Ddocs=false",
        "-Dgir=false",
        "-Dglade=false",
        "-Dgtk3=false",
        "-Dgtk4=true",
        "-D_systemd=false",
        "-Dvapi=false"
      ],
      "cleanup": [
        "/include",
        "/lib/pkgconfig"
      ],
      "sources": [
        {
          "type": "archive",
          "path": "sources/vte-0.84.1.tar.xz",
          "sha256": "aca1caa8478aebcdbb1d67897fb3511eb7601debae6810e16a15b6fa25f31ac8"
        }
      ]
    },
    {
      "name": "jetbrains-mono-font",
      "buildsystem": "simple",
      "build-commands": [
        "install -Dm644 JetBrainsMono-Regular.ttf /app/share/fonts/truetype/jetbrains-mono/JetBrainsMono-Regular.ttf"
      ],
      "sources": [
        {
          "type": "file",
          "url": "https://raw.githubusercontent.com/JetBrains/JetBrainsMono/v2.304/fonts/ttf/JetBrainsMono-Regular.ttf",
          "sha256": "a0bf60ef0f83c5ed4d7a75d45838548b1f6873372dfac88f71804491898d138f"
        }
      ]
    },
    {
      "name": "orbitterm",
      "buildsystem": "simple",
      "build-commands": [
        "cargo build --locked --offline --release --manifest-path clients/linux/Cargo.toml --package orbitterm-linux --config 'source.crates-io.replace-with=\"vendored-sources\"' --config 'source.vendored-sources.directory=\"clients/linux/packaging/flatpak/vendor\"'",
        "install -Dm755 clients/linux/target/release/orbitterm-linux /app/bin/orbitterm-linux",
        "install -Dm644 clients/linux/data/com.orbitterm.Client.desktop /app/share/applications/com.orbitterm.Client.desktop",
        "install -Dm644 clients/linux/data/com.orbitterm.Client.metainfo.xml /app/share/metainfo/com.orbitterm.Client.metainfo.xml",
        "install -Dm644 OrbitTerm/Assets.xcassets/AppIcon.appiconset/mac-16@1x.png /app/share/icons/hicolor/16x16/apps/com.orbitterm.Client.png",
        "install -Dm644 OrbitTerm/Assets.xcassets/AppIcon.appiconset/mac-32@1x.png /app/share/icons/hicolor/32x32/apps/com.orbitterm.Client.png",
        "install -Dm644 OrbitTerm/Assets.xcassets/AppIcon.appiconset/mac-32@2x.png /app/share/icons/hicolor/64x64/apps/com.orbitterm.Client.png",
        "install -Dm644 OrbitTerm/Assets.xcassets/AppIcon.appiconset/mac-128@1x.png /app/share/icons/hicolor/128x128/apps/com.orbitterm.Client.png",
        "install -Dm644 OrbitTerm/Assets.xcassets/AppIcon.appiconset/mac-256@1x.png /app/share/icons/hicolor/256x256/apps/com.orbitterm.Client.png",
        "install -Dm644 OrbitTerm/Assets.xcassets/AppIcon.appiconset/mac-512@1x.png /app/share/icons/hicolor/512x512/apps/com.orbitterm.Client.png",
        "install -Dm644 third_party/freerdp/linux-manifest.json /app/share/orbitterm/third-party/freerdp-linux-manifest.json"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "../../../..",
          "skip": [
            ".git",
            "clients/linux/target",
            "clients/linux/packaging/flatpak/build-dir",
            "clients/linux/packaging/flatpak/repo"
          ]
        }
      ]
    }
  ]
}
