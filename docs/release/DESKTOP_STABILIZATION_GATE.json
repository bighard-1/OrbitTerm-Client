  "evidence_contract": {
    "manifest_schema_version": 1,
    "storage": "restricted-release-evidence-store",
    "forbidden_fields": [
      "account",
      "endpoint",
      "host",
      "path",
      "command",
      "terminal_output",
      "credential",
      "token",
      "private_key",
      "device_udid"
