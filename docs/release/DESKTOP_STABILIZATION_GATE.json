{
  "schema_version": 2,
  "updated_at": "2026-10-02",
  "new_feature_freeze": true,
  "allowed_change_kinds": [
    "security",
    "data-consistency",
    "performance",
    "stability",
    "accessibility",
    "compatibility",
    "tests",
    "release-evidence"
  ],
  "required_domains": [
    "terminal",
